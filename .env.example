# ============================================================================
# CarePlus Hospital Information System (HIS) - Environment Variables
# ============================================================================

# --- SERVER CONFIGURATION ---
PORT=5000
NODE_ENV=production

# --- SECURITY & AUTHENTICATION ---
JWT_SECRET=careplus_super_secret_jwt_key_2026
JWT_EXPIRES_IN=24h

# --- FRONTEND CLIENT CONFIGURATION ---
# Optional: Set this if your backend API is hosted on a separate URL (e.g. Render/Railway)
# If using Vercel root vercel.json rewrites, leave as /api
VITE_API_BASE_URL=/api

# --- MYSQL DATABASE CONFIGURATION (OPTIONAL FOR LIVE DB) ---
# Note: CarePlus includes zero-config fallback seed DB if live DB credentials are omitted.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password123
DB_NAME=careplus_db
